# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:AAExampleTokenHere

# ID администратора (опционально, для уведомлений об ошибках)
ADMIN_CHAT_ID=

# Биржа-источник данных по умолчанию: binance / bybit / okx
DEFAULT_EXCHANGE=binance

# Интервал автоматического анализа в минутах
SCAN_INTERVAL_MINUTES=5

# Путь к файлу базы данных SQLite
DB_PATH=signals.db
